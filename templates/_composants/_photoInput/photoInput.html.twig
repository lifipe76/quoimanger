{# Composant Reutilisable PhotoInput (Multi-photos avec Drag&Drop) #}
{% set pfx = prefix|default('photo') %}
{% set currentUrls = current_photo_urls|default([]) %}
{% if currentUrls is empty and current_photo_url|default(null) %}
    {% set currentUrls = [current_photo_url] %}
{% endif %}
{% set currentNames = current_photos|default([]) %}
{% if currentNames is empty and current_photo_name|default(null) %}
    {% set currentNames = [current_photo_name] %}
{% endif %}
{% set hasDelete = has_delete_input is defined ? has_delete_input : true %}

<div class="form-group photo-input-component" id="{{ pfx }}-photo-component"
     data-prefix="{{ pfx }}"
     ondragover="onPhotoDragOver(event, '{{ pfx }}')"
     ondragleave="onPhotoDragLeave(event, '{{ pfx }}')"
     ondrop="onPhotoDrop(event, '{{ pfx }}')">

    {% if label is defined and label %}
        <label class="form-label photo-input-label">
            {{ label }}
        </label>
    {% endif %}

    <!-- Input pour l'appareil photo -->
    <input type="file"
           id="{{ pfx }}-photo-input"
           accept="image/*"
           capture="environment"
           style="display: none;"
           onchange="onPhotoSelected(this, '{{ pfx }}')">

    <!-- Input pour la sélection de fichiers multiple -->
    <input type="file"
           id="{{ pfx }}-photo-gallery-input"
           accept="image/*"
           multiple
           style="display: none;"
           onchange="onPhotoSelected(this, '{{ pfx }}')">

    <!-- Input principal soumis avec le formulaire (contient tous les fichiers ajoutés) -->
    <input type="file"
           id="{{ pfx }}-photos-input"
           name="photos[]"
           accept="image/*"
           multiple
           style="display: none;">

    <!-- Conteneur pour les inputs delete_photos[] -->
    <div id="{{ pfx }}-delete-inputs-container">
        {% if hasDelete %}
            <input type="hidden" name="delete_photo" id="{{ pfx }}-delete-photo-input" value="0">
        {% endif %}
    </div>

    <!-- Zone de prévisualisation des photos (existantes + nouvelles) et carte d'ajout -->
    <div class="photo-input-gallery" id="{{ pfx }}-photos-gallery">
        <!-- Photos existantes -->
        <div class="photo-input-grid" id="{{ pfx }}-existing-photos-grid">
            {% for url in currentUrls %}
                {% set filename = currentNames[loop.index0]|default(url|split('/')|last) %}
                <div class="photo-thumb-card photo-thumb-existing" id="{{ pfx }}-existing-photo-{{ loop.index0 }}">
                    <img src="{{ url }}" alt="{{ alt_text|default('') }}" class="photo-thumb-img" loading="lazy">
                    {% if hasDelete %}
                        <button type="button"
                                class="photo-thumb-btn-remove"
                                onclick="removeSpecificExistingPhoto('{{ pfx }}', '{{ filename }}', '{{ pfx }}-existing-photo-{{ loop.index0 }}')"
                                title="Supprimer cette photo"
                                aria-label="Supprimer cette photo">✕</button>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <!-- Nouvelles photos sélectionnées (générées dynamiquement par JS) -->
        <div class="photo-input-grid" id="{{ pfx }}-new-photos-grid"></div>

        <!-- Card d'ajout / Drag & Drop positionnée derrière les photos -->
        <div class="photo-drop-card" id="{{ pfx }}-dropzone"
             title="Ajouter ou glisser-déposer des photos"
             onclick="triggerPhotoGalleryInput('{{ pfx }}')">
            <div class="photo-drop-card-inner">
                <div class="photo-drop-card-icons">
                    <button type="button"
                            class="photo-drop-icon-btn"
                            onclick="event.stopPropagation(); triggerPhotoInput('{{ pfx }}')"
                            title="{{ camera_title|default('Prendre une photo') }}"
                            aria-label="{{ camera_title|default('Prendre une photo') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                            <circle cx="12" cy="13" r="3"/>
                        </svg>
                    </button>
                    <span class="photo-drop-icon-plus">+</span>
                </div>
                <span class="photo-drop-card-label">Ajouter</span>
                <span class="photo-drop-card-sub">ou glisser</span>
            </div>
        </div>
    </div>
</div>
