{% extends 'base.html.twig' %}

{% block title %}Connexion - QuoiManger{% endblock %}

{% block bottom_nav %}{% endblock %}

{% block body %}
{% set loginContent %}
    {% if app.user %}
        <div class="card" style="text-align: center; padding: 2.5rem 2rem;">
            <h1 class="page-title" style="font-size: 1.6rem; margin-bottom: 0.5rem;">Vous êtes déjà connecté</h1>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">
                Connecté avec le compte <strong>{{ app.user.userIdentifier }}</strong>
            </p>

            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                {{ composant('_composants/button', {
                    'titre': 'Accéder à la Timeline des Repas',
                    'href': path('home'),
                    'class': 'btn-primary',
                    'style': 'width: 100%;'
                }) }}
                {{ composant('_composants/button', {
                    'titre': 'Voir toutes les recettes',
                    'href': path('app_recettes_list'),
                    'class': 'btn-secondary',
                    'style': 'width: 100%;'
                }) }}
                {{ composant('_composants/button', {
                    'titre': 'Se déconnecter',
                    'href': path('web_logout'),
                    'class': 'btn-danger',
                    'style': 'width: 100%; margin-top: 0.5rem;'
                }) }}
            </div>
        </div>
    {% else %}

        {% if error %}
            <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <div class="card">

            <div style="text-align: center; margin-bottom: 2rem;">
                <h1 class="page-title" style="font-size: 1.85rem; margin-bottom: 0.5rem;">Connexion</h1>
                <p class="page-subtitle">
                    Accédez à vos recettes et suivez vos repas au quotidien
                </p>
            </div>

            <form method="post" action="{{ path('web_login') }}">
                <div class="form-group">
                    <label for="username" class="form-label">Adresse email</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="_username"
                           id="username"
                           class="form-control"
                           placeholder="nom@exemple.com"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label for="password" class="form-label">Mot de passe</label>
                    <div class="password-input-wrapper">
                        <input type="password"
                               name="_password"
                               id="password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               required>
                        <button type="button"
                                id="toggle-password-btn"
                                class="toggle-password-btn"
                                onclick="togglePasswordVisibility('password', this)"
                                title="Afficher/Masquer le mot de passe"
                                aria-label="Afficher ou masquer le mot de passe">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.5rem;">
                    <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--text-muted); cursor: pointer;">
                        <input type="checkbox" name="_remember_me" checked style="accent-color: var(--primary); width: 16px; height: 16px;">
                        Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" style="color: var(--primary); font-size: 0.875rem; font-weight: 600; text-decoration: none;">
                        Mot de passe oublié ?
                    </a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {{ composant('_composants/button', {
                    'titre': 'Se connecter',
                    'type': 'submit',
                    'class': 'btn-primary',
                    'style': 'width: 100%; padding: 0.85rem; font-size: 1rem;'
                }) }}
            </form>

            <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted); padding-top: 1.25rem; border-top: 1px solid var(--border-color);">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}" style="color: var(--primary); font-weight: 600; text-decoration: none;">
                    Créer un compte
                </a>
            </div>
        </div>

    {% endif %}
{% endset %}

{{ composant('_composants/container', {
    'style': 'max-width: 480px; margin: 2rem auto 3rem; padding: 0 1.5rem;',
    'content': loginContent
}) }}
{% endblock %}