{% extends 'base.logs.html.twig' %}

{% block title %}Connexion - QuoiManger{% endblock %}

{% block body %}
{% set loginContent %}
    {% if app.user %}
        <div class="card login-card-logged">
            <h1 class="page-title login-logged-title">Vous êtes déjà connecté</h1>
            <p class="login-logged-subtitle">
                Connecté avec le compte <strong>{{ app.user.userIdentifier }}</strong>
            </p>

            <div class="login-logged-actions">
                {{ composant('_composants/button', {
                    'titre': 'Accéder à la Timeline des Repas',
                    'href': path('home'),
                    'class': 'btn-primary login-btn-full'
                }) }}
                {{ composant('_composants/button', {
                    'titre': 'Voir toutes les recettes',
                    'href': path('app_recettes_list'),
                    'class': 'btn-secondary login-btn-full'
                }) }}
                {{ composant('_composants/button', {
                    'titre': 'Se déconnecter',
                    'href': path('web_logout'),
                    'class': 'btn-danger login-btn-full login-btn-logout'
                }) }}
            </div>
        </div>
    {% else %}

        {% if error %}
            <div class="alert alert-danger login-alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <div class="card login-card">

            {{ composant('_logs/_composants/zoneEntete',{'titre':'Connexion'}) }}

            <form method="post" action="{{ path('web_login') }}">
                <div class="form-group">
                    <label for="username" class="form-label">Adresse email</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="_username"
                           id="username"
                           class="form-control"
                           placeholder="nom@exemple.com"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <div class="form-group login-form-group-password">
                    <label for="password" class="form-label">Mot de passe</label>
                    <div class="password-input-wrapper">
                        <input type="password"
                               name="_password"
                               id="password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               required>
                        <button type="button"
                                id="toggle-password-btn"
                                class="toggle-password-btn"
                                onclick="togglePasswordVisibility('password', this)"
                                title="Afficher/Masquer le mot de passe"
                                aria-label="Afficher ou masquer le mot de passe">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="login-remember-row">
                    <label class="login-remember-label">
                        <input type="checkbox" name="_remember_me" checked class="login-remember-checkbox">
                        Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" class="login-forgot-link">
                        Mot de passe oublié ?
                    </a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {{ composant('_composants/button', {
                    'titre': 'Se connecter',
                    'type': 'submit',
                    'class': 'btn-primary login-btn-submit'
                }) }}
            </form>

            <div class="login-footer">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}" class="login-register-link">
                    Créer un compte
                </a>
            </div>
        </div>

    {% endif %}
{% endset %}

{{ composant('_composants/container', {
    'class': 'login-container',
    'content': loginContent
}) }}
{% endblock %}