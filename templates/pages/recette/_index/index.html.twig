{% extends 'base.html.twig' %}

{% block title %}Recettes - QuoiManger{% endblock %}

{% block body %}
{% set indexContent %}
    <div class="page-header recettes-header">
        <div class="recettes-header-title-wrap">
            <h1 class="page-title">Mes Recettes</h1>
            <p class="page-subtitle">{{ recettes|length }} recette{{ recettes|length > 1 ? 's' : '' }} au menu</p>
        </div>
        <a href="{{ path('app_recette_create') }}" class="btn-add-recette" title="Ajouter une recette">
            <span class="btn-text-full">+ Ajouter une recette</span>
            <span class="btn-text-mobile">+</span>
        </a>
    </div>

    <div class="recettes-toolbar">
        <div class="recettes-toolbar-sort-wrap">
            <span class="recettes-toolbar-label">Trier :</span>
            {% set nextOrder = (currentOrder|default('desc') == 'asc') ? 'desc' : 'asc' %}
            <a href="{{ path('app_recettes_list', {'sort': currentSort|default('date'), 'order': nextOrder}) }}"
               class="sort-order-btn"
               title="{{ currentOrder|default('desc') == 'asc' ? 'Tri croissant (cliquer pour trier par ordre décroissant)' : 'Tri décroissant (cliquer pour trier par ordre croissant)' }}"
               aria-label="{{ currentOrder|default('desc') == 'asc' ? 'Tri croissant (cliquer pour trier par ordre décroissant)' : 'Tri décroissant (cliquer pour trier par ordre croissant)' }}">
                {% if currentOrder|default('desc') == 'asc' %}
                    <i class="fa-solid fa-arrow-up sort-order-icon" aria-hidden="true"></i>
                {% else %}
                    <i class="fa-solid fa-arrow-down sort-order-icon" aria-hidden="true"></i>
                {% endif %}
            </a>
        </div>
        <div class="recettes-sort-pills">
            <a href="{{ path('app_recettes_list', {'sort': 'date'}) }}"
               class="sort-pill {{ currentSort in ['date', 'recent', 'oldest'] ? 'active' : '' }}">
                Date
            </a>
            <a href="{{ path('app_recettes_list', {'sort': 'note'}) }}"
               class="sort-pill {{ currentSort == 'note' ? 'active' : '' }}">
                Note
            </a>
            <a href="{{ path('app_recettes_list', {'sort': 'rank'}) }}"
               class="sort-pill {{ currentSort == 'rank' ? 'active' : '' }}">
                Rang
            </a>
            <a href="{{ path('app_recettes_list', {'sort': 'alpha'}) }}"
               class="sort-pill {{ currentSort == 'alpha' ? 'active' : '' }}">
                Nom
            </a>
        </div>
    </div>

    {% if recettes|length > 0 %}
        <div class="cards-grid">
            {% for recette in recettes %}
                {{ composant('cards/recette', { 'recette': recette, 'index': loop.index0, 'ranks': ranks|default({}) }) }}
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state card">
            <div class="empty-state-icon">🍳</div>
            <h2>Aucune recette pour le moment</h2>
            <p>Commencez par ajouter votre première recette avec ses ingrédients favoris.</p>
            <div style="margin-top: 1.5rem;">
                {{ composant('_composants/button', {
                    'titre': '+ Créer ma première recette',
                    'href': path('app_recette_create'),
                    'class': 'btn-primary'
                }) }}
            </div>
        </div>
    {% endif %}
{% endset %}

{{ composant('_composants/container', {
    'content': indexContent
}) }}
{% endblock %}
