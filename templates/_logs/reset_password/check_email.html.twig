{% extends 'base.html.twig' %}

{% block title %}Vérifiez vos emails - QuoiManger{% endblock %}

{% block body %}
{% set emailContent %}
    <div style="text-align: center; margin-bottom: 2rem;">
        <h1 class="page-title" style="font-size: 1.85rem; margin-bottom: 0.5rem;">Vérifiez vos emails</h1>
        <p class="page-subtitle">
            Un email de réinitialisation vous a été envoyé
        </p>
    </div>

    <div class="card" style="padding: 2.5rem 2rem;">
        <p style="color: #334155; font-size: 1rem; line-height: 1.6; margin-top: 0;">
            Si un compte correspond à votre adresse email, un lien sécurisé permettant de réinitialiser votre mot de passe vient d'être expédié.
        </p>

        <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem 1.25rem; margin: 1.5rem 0; display: flex; align-items: flex-start; gap: 0.75rem;">
            <div style="font-size: 0.875rem; color: var(--text-muted);">
                Ce lien de réinitialisation expirera dans <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
            </div>
        </div>

        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 2rem;">
            Vous ne trouvez pas l'email ? Pensez à vérifier votre dossier de courriers indésirables (spams) ou demandez un nouveau lien ci-dessous.
        </p>

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            {{ composant('_composants/button', {
                'titre': 'Renvoyer une demande',
                'href': path('app_forgot_password_request'),
                'class': 'btn-secondary',
                'style': 'width: 100%;'
            }) }}
            {{ composant('_composants/button', {
                'titre': 'Retour à la page de connexion',
                'href': path('web_login'),
                'class': 'btn-primary',
                'style': 'width: 100%;'
            }) }}
        </div>
    </div>
{% endset %}

{{ composant('_composants/container', {
    'style': 'max-width: 520px; margin: 3rem auto 5rem; padding: 0 1.5rem;',
    'content': emailContent
}) }}
{% endblock %}
