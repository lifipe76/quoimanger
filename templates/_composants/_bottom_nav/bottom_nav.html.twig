{% set current_route = app.current_route|default(app.request.attributes.get('_route')) %}

<nav class="bottom-app-nav" aria-label="Navigation mobile">
    <div class="bottom-app-nav-container">
        <!-- 1. Accueil / Timeline -->
        <a href="{{ path('home') }}"
           class="bottom-nav-item{{ current_route == 'home' ? ' active' : '' }}"
           title="Accueil Timeline">
            <span class="bottom-nav-icon">
                <i class="fa-solid fa-house"></i>
            </span>
            <span class="bottom-nav-label">Accueil</span>
        </a>

        <!-- 2. Recettes -->
        <a href="{{ path('app_recettes_list') }}"
           class="bottom-nav-item{{ current_route starts with 'app_recette' ? ' active' : '' }}"
           title="Mes Recettes">
            <span class="bottom-nav-icon">
                <i class="fa-solid fa-utensils"></i>
            </span>
            <span class="bottom-nav-label">Recettes</span>
        </a>

        <!-- 3. Bouton central Action Rapide Repas -->
        <div class="bottom-nav-center-action">
            {% if current_route == 'home' %}
                <button type="button"
                        class="bottom-nav-center-btn"
                        onclick="if (typeof openRepasModal === 'function') { openRepasModal(); } else { window.location.href = '{{ path('home') }}?open_modal=1'; }"
                        title="Enregistrer un repas">
                    <span class="center-btn-icon">
                        <i class="fa-solid fa-plus"></i>
                    </span>
                    <span class="center-btn-label">Repas</span>
                </button>
            {% else %}
                <a href="{{ path('home') }}?open_modal=1"
                   class="bottom-nav-center-btn"
                   title="Enregistrer un repas">
                    <span class="center-btn-icon">
                        <i class="fa-solid fa-plus"></i>
                    </span>
                    <span class="center-btn-label">Repas</span>
                </a>
            {% endif %}
        </div>

        <!-- 4. Ingrédients -->
        <a href="{{ path('app_ingredients_list') }}"
           class="bottom-nav-item{{ current_route starts with 'app_ingredient' ? ' active' : '' }}"
           title="Mes Ingrédients">
            <span class="bottom-nav-icon">
                <i class="fa-solid fa-carrot"></i>
            </span>
            <span class="bottom-nav-label">Ingrédients</span>
        </a>

        <!-- 5. Mon Compte / Famille ou Connexion -->
        {% if app.user %}
            <a href="{{ path('app_account_profile') }}"
               class="bottom-nav-item{{ (current_route starts with 'app_account' or current_route starts with 'app_famille') ? ' active' : '' }}"
               title="Mon compte & Ma famille">
                <span class="bottom-nav-icon">
                    <i class="fa-solid fa-users"></i>
                </span>
                <span class="bottom-nav-label">Famille</span>
            </a>
        {% else %}
            <a href="{{ path('web_login') }}"
               class="bottom-nav-item{{ current_route == 'web_login' ? ' active' : '' }}"
               title="Se connecter">
                <span class="bottom-nav-icon">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                </span>
                <span class="bottom-nav-label">Connexion</span>
            </a>
        {% endif %}
    </div>
</nav>
