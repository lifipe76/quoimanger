{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Nouvelle action' : 'Modifier l\'action' }} - QuoiFaire{% endblock %}

{% block body %}
{% if not isNew %}
    {{ composant('popups/confirmation') }}
    <form id="delete-action-form"
          method="post"
          action="{{ path('app_action_delete', {'id': action.id}) }}"
          data-confirm="Êtes-vous sûr de vouloir supprimer définitivement l'action « {{ action.designation }} » ?"
          data-confirm-title="Supprimer l'action"
          data-confirm-btn="Supprimer"
          style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_action_' ~ action.id) }}">
    </form>
{% endif %}

{% set formContent %}
    <div class="page-header">
        <h1 class="page-title">{{ isNew ? 'Ajouter une action' : 'Modifier l\'action' }}</h1>
        {{ composant('_composants/button', {
            'titre': 'Retour à la liste',
            'href': destination == 'quoifaire' ? path('quoifaire_home') : path('app_actions_list'),
            'class': 'btn-secondary'
        }) }}
    </div>

    <div class="card">
        {{ form_start(form, {
            'action': isNew ? path('app_action_create', destination ? {'destination': destination} : {}) : path('app_action_edit', destination ? {'id': action.id, 'destination': destination} : {'id': action.id}),
            'multipart': true,
            'attr': {'id': 'action-form', 'enctype': 'multipart/form-data'}
        }) }}
            <input type="hidden" name="destination" value="{{ destination }}">
            <div class="form-group">
                {{ form_label(form.designation, null, {'label_attr': {'class': 'form-label'} }) }}
                {{ form_widget(form.designation) }}
                {{ form_errors(form.designation, {'attr': {'class': 'form-error'} }) }}
            </div>

            <!-- Périodicité de l'action -->
            <div class="form-group action-periodique-box" style="margin: 1.5rem 0; padding: 1.25rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                <div class="form-check" style="display: flex; align-items: center; gap: 0.65rem;">
                    {{ form_widget(form.isPeriodique, {'attr': {'id': 'action-is-periodique-input', 'onchange': 'togglePeriodicFields(this.checked)'} }) }}
                    {{ form_label(form.isPeriodique, null, {'label_attr': {'class': 'form-check-label', 'for': 'action-is-periodique-input', 'style': 'font-weight: 600; cursor: pointer; margin: 0;'} }) }}
                </div>
                {{ form_errors(form.isPeriodique) }}

                <div id="periodic-fields-container" style="display: {{ form.isPeriodique.vars.checked ? 'block' : 'none' }}; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed #cbd5e1;">
                    <label class="form-label" style="font-weight: 600; margin-bottom: 0.5rem; display: block;">
                        Fréquence de répétition
                    </label>
                    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                        <span style="color: #64748b; font-weight: 500;">Tous les</span>
                        <div style="width: 100px;">
                            {{ form_widget(form.frequenceValeur, {'attr': {'class': 'form-control', 'placeholder': '1, 2...'} }) }}
                        </div>
                        <div style="min-width: 160px; flex: 1;">
                            {{ form_widget(form.frequenceUnite, {'attr': {'class': 'form-control form-select'} }) }}
                        </div>
                    </div>
                    {{ form_errors(form.frequenceValeur) }}
                    {{ form_errors(form.frequenceUnite) }}
                    <small class="form-text" style="color: #64748b; display: block; margin-top: 0.5rem;">
                        Exemple : tous les 15 jours, toutes les 2 semaines, tous les 3 mois, tous les ans...
                    </small>
                </div>
            </div>

            <script>
            function togglePeriodicFields(isChecked) {
                var container = document.getElementById('periodic-fields-container');
                if (container) {
                    container.style.display = isChecked ? 'block' : 'none';
                }
            }
            </script>

            {{ composant('_composants/photoInput', {
                'prefix': 'action',
                'label': "Photos de l'action",
                'current_photos': action.photos,
                'current_photo_urls': action.photoUrls,
                'alt_text': 'Photo de ' ~ action.designation,
                'camera_title': "Prendre une photo de l'action",
                'gallery_title': 'Choisir des fichiers'
            }) }}

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
                <div>
                    {% if not isNew %}
                        <button type="submit"
                                form="delete-action-form"
                                class="btn btn-danger btn-sm btn-delete-small"
                                title="Supprimer définitivement cette action"
                                aria-label="Supprimer cette action">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                </div>
                <div style="display: flex; gap: 1rem; margin-left: auto;">
                    {{ composant('_composants/button', {
                        'titre': 'Annuler',
                        'href': destination == 'quoifaire' ? path('quoifaire_home') : path('app_actions_list'),
                        'class': 'btn-secondary'
                    }) }}
                    {{ composant('_composants/button', {
                        'titre': isNew ? 'Créer l\'action' : 'Enregistrer les modifications',
                        'type': 'submit',
                        'class': 'btn-primary'
                    }) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>
{% endset %}

{{ composant('_composants/container', {
    'content': formContent
}) }}
{% endblock %}
