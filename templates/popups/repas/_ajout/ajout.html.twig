<!-- Modal Popup "Je rentre mon repas" -->
{% set popupContent %}

    <div class="modal-proposition-header">
        <h3 class="modal-proposition-title">Ajouter votre repas</h3>
        <p class="modal-proposition-subtitle">Choisissez une recette et un moment pour l'ajouter à vos repas.</p>
    </div>

    <!-- Choix de la date et moment sur la même ligne (composant réutilisable) -->
    {{ composant('popups/sections/date', {
        'id_prefix': 'repas',
        'input_name': 'date',
        'on_date_change': 'onRepasDateInputChange(this.value)',
        'on_quick_click': 'selectRepasDate',
        'on_moment_click': 'selectRepasMoment'
    }) }}

    <!-- Barre de recherche (loupe extensible) et filtres de tri -->
    <div class="modal-top-bar" id="repas-modal-top-bar">
        {{ composant('_composants/_popup/recherche', {
            'id': 'recipe-filter-input',
            'placeholder': 'Rechercher...',
            'target': '.modal-recipe-form',
            'oninput': 'filterRecipesList(this.value)'
        }) }}
        <button type="button"
                class="modal-sort-order-btn"
                data-order="desc"
                title="Tri décroissant (cliquer pour inverser)"
                aria-label="Sens du tri"
                onclick="toggleModalSortOrder(this, 'modal-recipes-container')">
            <i class="fa-solid fa-arrow-down sort-order-icon" aria-hidden="true"></i>
        </button>
        <div class="modal-sort-pills">
            <button type="button" class="sort-pill active" data-sort="probability" onclick="sortModalRecipes('probability', this, 'modal-recipes-container')">Probabilité</button>
            <button type="button" class="sort-pill" data-sort="date" onclick="sortModalRecipes('date', this, 'modal-recipes-container')">Date</button>
            <button type="button" class="sort-pill" data-sort="note" onclick="sortModalRecipes('note', this, 'modal-recipes-container')">Note</button>
            <button type="button" class="sort-pill" data-sort="rank" onclick="sortModalRecipes('rank', this, 'modal-recipes-container')">Rang</button>
            <button type="button" class="sort-pill" data-sort="alpha" onclick="sortModalRecipes('alpha', this, 'modal-recipes-container')">Nom</button>
        </div>
    </div>

    <!-- Onglets Proposition vs Mon frigo -->
    <div class="modal-tabs-bar">
        <button type="button" class="modal-tab-pill active" id="tab-btn-ajout-toutes" onclick="switchRepasTab('toutes')">
            Proposition
        </button>
        <button type="button" class="modal-tab-pill" id="tab-btn-ajout-frigo" onclick="switchRepasTab('frigo')">
            Mon frigo ({{ frigoItems is defined ? frigoItems|length : 0 }})
        </button>
    </div>

    <!-- Contenu Tab 1 : Proposition (toutes les recettes classées par probabilité) -->
    <div class="modal-recipes-list modal-tab-content active" id="modal-recipes-container">
        {% set listeRecettes = recettesProposees|default(recettes) %}
        {% if listeRecettes|length > 0 %}
            {% for r in listeRecettes %}
                {% set probScore = (probabilityScores is defined and probabilityScores[r.id] is defined) ? probabilityScores[r.id] : 0 %}
                <form method="post" action="{{ path('app_realisation_add') }}"
                      class="modal-recipe-form"
                      data-name="{{ r.designation|lower }}"
                      data-date="{{ r.lastRealiseAt ? r.lastRealiseAt|date('U') : 0 }}"
                      data-probability="{{ probScore }}"
                      data-note="{{ r.averageNote|default(0) }}"
                      data-count="{{ r.notesCount|default(0) }}"
                      data-rank="{{ (ranks is defined and ranks[r.id] is defined and ranks[r.id] is not null) ? ranks[r.id] : 999999 }}"
                      data-id="{{ r.id }}">
                    <input type="hidden" name="recette_id" value="{{ r.id }}">
                    <input type="hidden" name="moment" class="input-form-moment" value="{{ defaultMoment|default('soir') }}">
                    <input type="hidden" name="date" class="input-form-date" value="{{ 'now'|date('Y-m-d') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('add_realisation') }}">
                    {{ composant('cards/popup/recette', {
                        'recette': r,
                        'ranks': ranks|default({}),
                        'action_label': 'Valider →'
                    }) }}
                </form>
            {% endfor %}
        {% else %}
            <div class="empty-state" style="padding: 2rem 1rem;">
                <div style="margin-top: 0.5rem;">
                    {{ composant('_composants/button', {
                        'titre': '+ Créer une recette d\'abord',
                        'href': path('app_recette_create', {'destination': 'repas'}),
                        'class': 'btn-primary'
                    }) }}
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Contenu Tab 2 : Mon frigo -->
    <div class="modal-recipes-list modal-tab-content" id="modal-ajout-frigo-container" style="display: none;">
        {% if frigoItems is defined and frigoItems|length > 0 %}
            {% for f in frigoItems %}
                {% if f.recette %}
                    {% set r = f.recette %}
                    {% set probScore = (probabilityScores is defined and probabilityScores[r.id] is defined) ? probabilityScores[r.id] : 0 %}
                    <form method="post" action="{{ path('app_realisation_add') }}"
                          class="modal-recipe-form modal-frigo-direct-form"
                          data-name="{{ r.designation|lower }}"
                          data-date="{{ r.lastRealiseAt ? r.lastRealiseAt|date('U') : 0 }}"
                          data-probability="{{ probScore }}"
                          data-note="{{ r.averageNote|default(0) }}"
                          data-count="{{ r.notesCount|default(0) }}"
                          data-rank="{{ (ranks is defined and ranks[r.id] is defined and ranks[r.id] is not null) ? ranks[r.id] : 999999 }}"
                          data-id="{{ r.id }}">
                        <input type="hidden" name="recette_id" value="{{ r.id }}">
                        <input type="hidden" name="moment" class="input-form-moment" value="{{ defaultMoment|default('soir') }}">
                        <input type="hidden" name="date" class="input-form-date" value="{{ 'now'|date('Y-m-d') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('add_realisation') }}">
                        {{ composant('cards/popup/recette', {
                            'recette': r,
                            'ranks': ranks|default({}),
                            'action_label': 'Manger (sortir du frigo) →'
                        }) }}
                    </form>
                {% endif %}
            {% endfor %}
        {% else %}
            <div class="empty-state frigo-empty-state" style="padding: 2rem 1rem; text-align: center;">
                <p class="frigo-empty-message">Mon frigo est vide.</p>
                <div style="margin-top: 0.75rem;">
                    {{ composant('_composants/button', {
                        'titre': 'Gérer mon frigo',
                        'type': 'button',
                        'class': 'btn-secondary',
                        'onclick': 'closeRepasModal(); openFrigoModal();'
                    }) }}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="modal-footer modal-footer-center">
        {{ composant('_composants/button', {
            'titre': '+ Créer une nouvelle recette',
            'href': path('app_recette_create', {'destination': 'repas'}),
            'class': 'btn-primary',
            'style': 'width: 100%;'
        }) }}
    </div>
{% endset %}

{{ composant('_composants/popup', {
    'id': 'repas-modal',
    'content': popupContent,
    'onClose': 'closeRepasModal()',
    'onBackdropClick': 'handleModalBackdropClick(event, "repas-modal")'
}) }}