<!-- Modal Popup "Mon frigo" -->
{% set popupContent %}
    <div class="modal-frigo-header">
        <h3 class="modal-frigo-title">Mon frigo</h3>
        <p class="modal-frigo-subtitle">Ajoutez ou retirez les recettes actuellement stockées dans votre frigo.</p>
    </div>

    {% if frigoItems is defined and frigoItems|length > 0 %}
        <div class="modal-frigo-current-section">
            <div class="modal-frigo-section-title">Actuellement dans mon frigo ({{ frigoItems|length }}) :</div>
            <div class="modal-frigo-current-list">
                {% for f in frigoItems %}
                    {% if f.recette %}
                        <div class="frigo-badge-item">
                            <span class="frigo-badge-name">{{ f.recette.designation }}</span>
                            <form method="post" action="{{ path('app_frigo_remove') }}" class="frigo-remove-form" onsubmit="event.stopPropagation();">
                                <input type="hidden" name="recette_id" value="{{ f.recette.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('frigo_remove') }}">
                                <button type="submit" class="btn-frigo-remove" title="Retirer du frigo" aria-label="Retirer {{ f.recette.designation }} du frigo">
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- Barre de recherche et filtres de tri -->
    <div class="modal-top-bar">
        {{ composant('_composants/_popup/recherche', {
            'id': 'frigo-recipe-filter-input',
            'placeholder': 'Rechercher une recette...',
            'target': '.modal-frigo-recipe-form',
            'oninput': 'filterFrigoRecipesList(this.value)'
        }) }}
        <button type="button"
                class="modal-sort-order-btn"
                data-order="desc"
                title="Tri décroissant (cliquer pour inverser)"
                aria-label="Sens du tri"
                onclick="toggleModalSortOrder(this, 'modal-frigo-recipes-container')">
            <i class="fa-solid fa-arrow-down sort-order-icon" aria-hidden="true"></i>
        </button>
        <div class="modal-sort-pills">
            <button type="button" class="sort-pill active" data-sort="probability" onclick="sortModalRecipes('probability', this, 'modal-frigo-recipes-container')">Probabilité</button>
            <button type="button" class="sort-pill" data-sort="date" onclick="sortModalRecipes('date', this, 'modal-frigo-recipes-container')">Date</button>
            <button type="button" class="sort-pill" data-sort="note" onclick="sortModalRecipes('note', this, 'modal-frigo-recipes-container')">Note</button>
            <button type="button" class="sort-pill" data-sort="rank" onclick="sortModalRecipes('rank', this, 'modal-frigo-recipes-container')">Rang</button>
            <button type="button" class="sort-pill" data-sort="alpha" onclick="sortModalRecipes('alpha', this, 'modal-frigo-recipes-container')">Nom</button>
        </div>
    </div>

    <div class="modal-recipes-list" id="modal-frigo-recipes-container">
        {% set listeRecettes = recettesProposees|default(recettes) %}
        {% if listeRecettes|length > 0 %}
            {% for r in listeRecettes %}
                {% set isInFrigo = (frigoRecetteIds is defined and r.id in frigoRecetteIds) %}
                {% set probScore = (probabilityScores is defined and probabilityScores[r.id] is defined) ? probabilityScores[r.id] : 0 %}
                <form method="post" action="{{ isInFrigo ? path('app_frigo_remove') : path('app_frigo_add') }}"
                      class="modal-recipe-form modal-frigo-recipe-form {{ isInFrigo ? 'recipe-in-frigo' : '' }}"
                      data-name="{{ r.designation|lower }}"
                      data-date="{{ r.lastRealiseAt ? r.lastRealiseAt|date('U') : 0 }}"
                      data-probability="{{ probScore }}"
                      data-note="{{ r.averageNote|default(0) }}"
                      data-count="{{ r.notesCount|default(0) }}"
                      data-rank="{{ (ranks is defined and ranks[r.id] is defined and ranks[r.id] is not null) ? ranks[r.id] : 999999 }}"
                      data-id="{{ r.id }}">
                    <input type="hidden" name="recette_id" value="{{ r.id }}">
                    <input type="hidden" name="_token" value="{{ csrf_token(isInFrigo ? 'frigo_remove' : 'frigo_add') }}">
                    {{ composant('cards/popup/recette', {
                        'recette': r,
                        'ranks': ranks|default({}),
                        'action_label': isInFrigo ? 'Retirer du frigo ✕' : 'Ajouter au frigo +'
                    }) }}
                </form>
            {% endfor %}
        {% else %}
            <div class="empty-state" style="padding: 2rem 1rem;">
                <p>Aucune recette disponible pour le moment.</p>
                <div style="margin-top: 0.5rem;">
                    {{ composant('_composants/button', {
                        'titre': '+ Créer une recette d\'abord',
                        'href': path('app_recette_create'),
                        'class': 'btn-primary'
                    }) }}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="modal-footer modal-footer-center">
        {{ composant('_composants/button', {
            'titre': '+ Créer une nouvelle recette',
            'href': path('app_recette_create', {'destination': 'frigo'}),
            'class': 'btn-primary',
            'style': 'width: 100%;'
        }) }}
    </div>
{% endset %}

{{ composant('_composants/popup', {
    'id': 'repas-frigo-modal',
    'content': popupContent,
    'onClose': 'closeFrigoModal()',
    'onBackdropClick': 'handleModalBackdropClick(event, "repas-frigo-modal")'
}) }}
