{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Nouvel ingrédient' : 'Modifier l\'ingrédient' }} - QuoiManger{% endblock %}

{% block body %}
{% set formContent %}
    <div class="page-header">
        <h1 class="page-title">{{ isNew ? 'Ajouter un ingrédient' : 'Modifier l\'ingrédient' }}</h1>
        {{ composant('_composants/button', {
            'titre': 'Retour à la liste',
            'href': path('app_ingredients_list'),
            'class': 'btn-secondary'
        }) }}
    </div>

    <div class="card">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.designation, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.designation) }}
                {{ form_errors(form.designation, {'attr': {'class': 'form-error'}}) }}
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                {{ composant('_composants/button', {
                    'titre': 'Annuler',
                    'href': path('app_ingredients_list'),
                    'class': 'btn-secondary'
                }) }}
                {{ composant('_composants/button', {
                    'titre': isNew ? 'Créer l\'ingrédient' : 'Enregistrer les modifications',
                    'type': 'submit',
                    'class': 'btn-primary'
                }) }}
            </div>
        {{ form_end(form) }}
    </div>
{% endset %}

{{ composant('_composants/container', {
    'content': formContent
}) }}
{% endblock %}
