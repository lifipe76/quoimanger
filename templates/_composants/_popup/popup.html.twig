{# Composant générique Popup / Modal #}
<div id="{{ id }}" 
     class="modal-overlay{{ overlayClass is defined and overlayClass ? ' ' ~ overlayClass : '' }}" 
     style="{{ overlayStyle|default('display: none;') }}" 
     onclick="{{ onBackdropClick|default("handleModalBackdropClick(event, '" ~ id ~ "')") }}">
    <div class="modal-dialog{{ dialogClass is defined and dialogClass ? ' ' ~ dialogClass : '' }}"
         {% if dialogStyle is defined and dialogStyle %}style="{{ dialogStyle }}"{% endif %}>
        
        <button type="button" 
                class="modal-close-btn" 
                onclick="{{ onClose|default("closeModal('" ~ id ~ "')") }}" 
                title="{{ closeTitle|default('Fermer') }}" 
                aria-label="{{ closeTitle|default('Fermer') }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        {% if title is defined and title %}
            <div class="modal-header">
                <h2 class="modal-title">{{ title|raw }}</h2>
                {% if subtitle is defined and subtitle %}
                    <p class="modal-subtitle">{{ subtitle|raw }}</p>
                {% endif %}
            </div>
        {% endif %}

        {{ content|default(body|default(''))|raw }}
    </div>
</div>
