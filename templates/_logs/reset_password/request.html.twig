{% extends 'base.html.twig' %}

{% block title %}Demande de changement de mot de passe{% endblock %}

{% block body %}

{% block stylesheets %}
    {{ parent() }}   
    {{ addCss('styles/_logs/resetPassword.css') }}
    {{ addCss('styles/_logs/communs.css') }}
    {{ addCss('styles/pageContainer.css') }}
    {{ addCss('styles/formContainer.css') }}
{% endblock %}

<div id='pageContainer'>

    <div class='formContainer containerBlanc'>

        {# <a id='retour' href="{{url('web_login')}}">{{ux_icon('mdi:arrow-back', {height: '16px', width: '16px' })}}retour</a> #}

        {{ include('_logs/_composants/zoneEntete.html.twig') }}

        {{ include('_logs/_composants/zoneTitre.html.twig', {titre:"reset_password.request.titre"|trans})}}

        <div class='corps'>

            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
            {% endfor %}

            {{ form_start(requestForm) }}
            {{ form_row(requestForm.email, { label : 'reset_password.request.explique'|trans ,'row_attr':{'class':'champ'}}) }}

            <div class="connect">
                {{ composant('_composants/button',{'submit':true,'titre':'reset_password.request.button'|trans})}}
            </div>

            {{ form_end(requestForm) }}

        </div>       

        {# {{ include('_logs/_composants/zoneRegister.html.twig') }} #}
    
    </div>

</div>

{% endblock %}

{% block footer %}
{% endblock %}
