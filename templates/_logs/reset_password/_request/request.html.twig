{% extends 'base.logs.html.twig' %}

{% block title %}Mot de passe oublié - QuoiManger{% endblock %}

{% block menu %}{% endblock %}

{% block body %}
{% set requestContent %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger request-alert">
            {{ flash_error }}
        </div>
    {% endfor %}

    <div class="card request-card">

        {{ composant('_logs/_composants/zoneEntete',{'titre':'Mot de passe oublié','explique':'Entrez votre adresse email pour recevoir un lien de réinitialisation sécurisé'}) }}

        {{ form_start(requestForm) }}
            <div class="form-group">
                <label for="{{ requestForm.email.vars.id }}" class="form-label">Votre adresse email</label>
                {{ form_widget(requestForm.email, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'nom@exemple.com',
                        'autofocus': 'autofocus'
                    }
                }) }}
                {{ form_errors(requestForm.email, {'attr': {'class': 'form-error'} }) }}
            </div>

            {{ composant('_composants/button', {
                'titre': 'Envoyer le lien de réinitialisation',
                'type': 'submit',
                'class': 'btn-primary request-btn-submit'
            }) }}
        {{ form_end(requestForm) }}

    </div>
{% endset %}

{{ composant('_composants/container', {
    'class': 'request-container',
    'content': requestContent
}) }}
{% endblock %}
