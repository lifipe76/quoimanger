{% extends 'base.html.twig' %}

{% block title %}Mon compte - QuoiManger{% endblock %}

{% block body %}
{% set profileContent %}
    <div class="page-header">
        <h1 class="page-title">Mon compte</h1>
    </div>

    <!-- Onglets de navigation -->
    <div class="account-tabs" role="tablist">
        <button type="button" class="account-tab-btn {{ activeTab|default('profil') == 'profil' ? 'active' : '' }}" data-tab="profil" role="tab" aria-selected="{{ activeTab|default('profil') == 'profil' ? 'true' : 'false' }}">
            <span>Profil</span>
        </button>
        <button type="button" class="account-tab-btn {{ activeTab|default('profil') == 'famille' ? 'active' : '' }}" data-tab="famille" role="tab" aria-selected="{{ activeTab|default('profil') == 'famille' ? 'true' : 'false' }}">
            <span>Ma famille</span>
            {% if receivedInvitations is defined and receivedInvitations|length > 0 %}
                <span class="tab-alert-badge" title="Invitation en attente">!</span>
            {% elseif famille %}
                <span class="tab-badge">{{ (confirmedMembres|default(famille.membres))|length }}</span>
            {% endif %}
        </button>
        <button type="button"
                class="account-tab-btn account-tab-logout-btn"
                id="account-tab-logout"
                title="Se déconnecter"
                aria-label="Se déconnecter"
                onclick="confirmAccountLogout('{{ path('web_logout') }}')">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-logout-icon" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
        </button>
    </div>

    <!-- Contenu Onglet 1 : Profil -->
    <div id="tab-profil" class="account-tab-pane {{ activeTab|default('profil') == 'profil' ? 'active' : '' }}" role="tabpanel">
        <div class="card profile-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    {{ (user.firstname|first ~ user.lastname|first)|upper|default((user.email|first)|upper) }}
                </div>
                <div>
                    <h2 class="profile-name">
                        {{ (user.firstname ~ ' ' ~ user.lastname)|trim ?: user.userIdentifier }}
                    </h2>
                    <div class="profile-email">
                        {{ user.email }}
                    </div>
                </div>
            </div>

            {{ form_start(form) }}
                <div class="profile-grid">
                    <div class="form-group">
                        {{ form_label(form.firstname, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.firstname) }}
                        {{ form_errors(form.firstname, {'attr': {'class': 'form-error'}}) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.lastname, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.lastname) }}
                        {{ form_errors(form.lastname, {'attr': {'class': 'form-error'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email, {'attr': {'class': 'form-error'}}) }}
                </div>

                <div class="profile-security-section">
                    <h3 class="profile-section-title">
                        Modifier le mot de passe
                    </h3>
                    <p class="profile-section-desc">
                        Laissez les champs ci-dessous vides si vous ne souhaitez pas modifier votre mot de passe actuel.
                    </p>

                    <div class="form-group">
                        {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="password-input-wrapper">
                            {{ form_widget(form.newPassword.first) }}
                            <button type="button"
                                    class="toggle-password-btn"
                                    onclick="togglePasswordVisibility('{{ form.newPassword.first.vars.id }}', this)"
                                    title="Afficher/Masquer le mot de passe"
                                    aria-label="Afficher ou masquer le mot de passe">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        {{ form_errors(form.newPassword.first, {'attr': {'class': 'form-error'}}) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="password-input-wrapper">
                            {{ form_widget(form.newPassword.second) }}
                            <button type="button"
                                    class="toggle-password-btn"
                                    onclick="togglePasswordVisibility('{{ form.newPassword.second.vars.id }}', this)"
                                    title="Afficher/Masquer le mot de passe"
                                    aria-label="Afficher ou masquer le mot de passe">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        {{ form_errors(form.newPassword.second, {'attr': {'class': 'form-error'}}) }}
                    </div>
                </div>

                <div class="profile-actions">
                    {{ composant('_composants/button', {
                        'titre': 'Annuler',
                        'href': path('home'),
                        'class': 'btn-secondary'
                    }) }}
                    {{ composant('_composants/button', {
                        'titre': 'Enregistrer les modifications',
                        'type': 'submit',
                        'class': 'btn-primary'
                    }) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <!-- Contenu Onglet 2 : Ma Famille -->
    <div id="tab-famille" class="account-tab-pane {{ activeTab|default('profil') == 'famille' ? 'active' : '' }}" role="tabpanel">
        <div class="card family-card">
            <div class="family-header">
                <div class="family-title-group">
                    <div>
                        <h2 class="family-title">
                            <span>{{ famille ? famille.nom : 'Ma Famille' }}</span>
                            {% if famille and isChef and not isPendingMember %}
                                <button type="button" class="family-edit-btn" onclick="openModal('rename-family-modal')" title="Renommer la famille" aria-label="Renommer la famille">
                                    <i class="fa-solid fa-pencil"></i>
                                </button>
                            {% endif %}
                        </h2>
                        <p class="family-subtitle">
                            Regroupez vos proches pour suivre qui partage chaque repas au quotidien
                        </p>
                    </div>
                </div>

                {% if famille and not isChef and not isPendingMember %}
                    <div class="family-leave-wrapper">
                        {{ composant('_composants/button', {
                            'titre': 'Quitter la famille',
                            'type': 'button',
                            'class': 'btn-danger btn-sm family-leave-btn',
                            'onclick': "openModal('leave-family-modal')"
                        }) }}
                    </div>
                {% endif %}
            </div>

            <!-- Invitations reçues en attente de réponse (si c'est vous qui avez reçu une invitation) -->
            {% if receivedInvitations is defined and receivedInvitations|length > 0 %}
                <div class="family-received-invitations-box">
                    <h3 class="family-received-title">
                        Invitation{% if receivedInvitations|length > 1 %}s{% endif %} reçue{% if receivedInvitations|length > 1 %}s{% endif %} en attente
                    </h3>
                    <p class="family-received-desc">
                        Vous avez reçu une proposition pour rejoindre un foyer familial. Vous pouvez accepter ou refuser ci-dessous :
                    </p>
                    <div class="family-received-list">
                        {% for invite in receivedInvitations %}
                            <div class="family-received-item">
                                <div>
                                    <div class="family-received-name">
                                        Famille « {{ invite.famille.nom }} »
                                    </div>
                                    <div class="family-received-sender">
                                        Invité(e) par <strong>{{ invite.demandeur.displayName }}</strong>
                                        <span class="family-pending-date">(le {{ invite.createdAt|date('d/m/Y') }})</span>
                                    </div>
                                </div>
                                <div class="family-received-actions">
                                    <form method="post" action="{{ path('app_famille_invitation_accepter', {'id': invite.id}) }}" style="margin: 0; display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('accept_invitation_' ~ invite.id) }}">
                                        {{ composant('_composants/button', {
                                            'titre': 'Accepter',
                                            'type': 'submit',
                                            'class': 'btn-primary btn-sm'
                                        }) }}
                                    </form>
                                    <form method="post" action="{{ path('app_famille_invitation_refuser', {'id': invite.id}) }}" style="margin: 0; display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('refuse_invitation_' ~ invite.id) }}">
                                        {{ composant('_composants/button', {
                                            'titre': 'Refuser',
                                            'type': 'submit',
                                            'class': 'btn-secondary btn-sm'
                                        }) }}
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if famille %}
                {% set membersToDisplay = confirmedMembres|default(famille.membres) %}
                <!-- Liste des membres -->
                <h3 class="family-members-title">
                    Membres de la famille ({{ membersToDisplay|length + (isPendingMember ? 1 : 0) }}{% if isChef and sentInvitations is defined and sentInvitations|length > 0 %} + {{ sentInvitations|length }} en attente{% endif %})
                </h3>
                <div class="family-members-list">
                    {% for membre in membersToDisplay %}
                        <div class="family-member-item">
                            <div class="family-member-info">
                                <div class="family-member-avatar">
                                    {{ (membre.firstname|first ~ membre.lastname|first)|upper|default((membre.email|first)|upper) }}
                                </div>
                                <div>
                                    <span class="family-member-name">
                                        {{ membre.displayName }}
                                    </span>
                                    {% if famille.isChef(membre) %}
                                        <span class="family-member-tag-chef">Chef de famille</span>
                                    {% endif %}
                                    {% if membre == user %}
                                        <span class="family-member-tag-you">Vous</span>
                                    {% endif %}
                                    <div class="family-member-email">{{ membre.email }}</div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    {# Si l'utilisateur connecté est invité et en attente d'acceptation dans cette famille #}
                    {% if isPendingMember and pendingInvitation is defined and pendingInvitation %}
                        <div class="family-member-item family-member-pending">
                            <div class="family-member-info">
                                <div class="family-member-avatar">
                                    {{ (user.firstname|first ~ user.lastname|first)|upper|default((user.email|first)|upper) }}
                                </div>
                                <div>
                                    <span class="family-member-name">
                                        {{ user.displayName }}
                                    </span>
                                    <span class="family-member-tag-you">Vous</span>
                                    <span class="family-member-tag-pending">
                                        En attente d'acceptation
                                    </span>
                                    <div class="family-member-email">{{ user.email }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {# Membres invités en attente d'acceptation : UNIQUEMENT visibles par le chef de famille ! #}
                    {% if isChef and sentInvitations is defined and sentInvitations|length > 0 %}
                        {% for inv in sentInvitations %}
                            <div class="family-member-item family-member-pending">
                                <div class="family-member-info">
                                    <div class="family-member-avatar">
                                        {{ (inv.inviteUser ? (inv.inviteUser.firstname|first ~ inv.inviteUser.lastname|first)|upper : (inv.inviteEmail|first)|upper) }}
                                    </div>
                                    <div>
                                        <span class="family-member-name" style="color: #64748b;">
                                            {{ inv.inviteUser ? inv.inviteUser.displayName : inv.inviteEmail }}
                                        </span>
                                        <span class="family-member-tag-pending">
                                            En attente d'acceptation
                                        </span>
                                        <div class="family-member-email">{{ inv.inviteEmail }}</div>
                                    </div>
                                </div>
                                <form method="post" action="{{ path('app_famille_invitation_annuler', {'id': inv.id}) }}" class="family-pending-cancel-form" style="margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_invitation_' ~ inv.id) }}">
                                    {{ composant('_composants/button', {
                                        'titre': 'Annuler',
                                        'type': 'submit',
                                        'class': 'btn-secondary btn-sm'
                                    }) }}
                                </form>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            {% else %}
                <p class="family-empty-desc">
                    {% if receivedInvitations is defined and receivedInvitations|length > 0 %}
                        Vous n'avez pas encore rejoint de famille. Vous avez une invitation en attente ci-dessus pour rejoindre un foyer, ou vous pouvez inviter un proche par email ci-dessous pour créer le vôtre.
                    {% else %}
                        Vous ne faites partie d'aucune famille pour le moment. Invitez un proche par email ci-dessous pour créer votre foyer familial !
                    {% endif %}
                </p>
            {% endif %}

            <!-- Formulaire d'invitation (visible uniquement pour le chef ou si aucune famille) -->
            {% if (not famille and not isPendingMember) or (isChef and not isPendingMember) %}
                <div class="family-invite-box">
                    <h3 class="family-invite-title">
                        Inviter un proche par email
                    </h3>
                    <p class="family-invite-desc">
                        Un bandeau s'affichera sur son compte pour lui proposer de rejoindre votre famille.
                    </p>

                    <form method="post" action="{{ path('app_famille_inviter') }}" class="family-invite-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('famille_inviter') }}">
                        <input type="email" name="invite_email" placeholder="nom.proche@exemple.com" required class="form-control family-invite-input">
                        {{ composant('_composants/button', {
                            'titre': 'Envoyer l\'invitation',
                            'type': 'submit',
                            'class': 'btn-primary'
                        }) }}
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endset %}

{{ composant('_composants/container', {
    'content': profileContent
}) }}

{% if famille and not isChef and not isPendingMember %}
    {{ composant('popups/compte/famille/quitte', {'famille': famille}) }}
{% endif %}

{% if famille and isChef and not isPendingMember %}
    {{ composant('popups/compte/famille/renommer', {'famille': famille}) }}
{% endif %}

{{ composant('popups/confirmation') }}

<script>
function confirmAccountLogout(logoutUrl) {
    if (typeof openConfirmPopup === "function") {
        openConfirmPopup({
            title: "Déconnexion",
            message: "Êtes-vous sûr de vouloir vous déconnecter ?",
            confirmText: "Se déconnecter",
            confirmClass: "btn-danger",
            onConfirm: function () {
                window.location.href = logoutUrl;
            }
        });
    } else if (confirm("Êtes-vous sûr de vouloir vous déconnecter ?")) {
        window.location.href = logoutUrl;
    }
}
</script>
{% endblock %}
