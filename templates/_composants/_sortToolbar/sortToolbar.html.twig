{# Composant Barre de Tri réutilisable avec recherche intégrée #}
{% set nextOrder = (currentOrder|default('desc') == 'asc') ? 'desc' : 'asc' %}
{% set labelText = label|default('Trier :') %}
{% set routeParams = routeParams|default({}) %}
{% set withSearch = withSearch is defined ? withSearch : true %}
{% set defaultTarget = (route|default('') == 'app_recettes_list') ? '.card-recette' : ((route|default('') == 'app_ingredients_list') ? '.card-ingredient' : '') %}
{% set searchTarget = searchTarget|default(defaultTarget) %}
{% set defaultPlaceholder = (route|default('') == 'app_ingredients_list') ? 'Rechercher un ingrédient...' : 'Rechercher une recette...' %}
{% set searchPlaceholder = searchPlaceholder|default(defaultPlaceholder) %}
{% set searchId = searchId|default((route|default('sort') ~ '-search-input')|replace({'_': '-'})) %}

<div class="recettes-toolbar sort-toolbar"
     {% if storageKey is defined and storageKey %}
         data-storage-key="{{ storageKey }}"
         data-default-sort="{{ defaultSort|default('alpha') }}"
         data-default-order="{{ defaultOrder|default('asc') }}"
     {% endif %}>
    <div class="recettes-toolbar-sort-wrap sort-toolbar-order-wrap">
        {% if withSearch and searchTarget %}
            {{ composant('_composants/_popup/recherche', {
                'id': searchId,
                'placeholder': searchPlaceholder,
                'target': searchTarget
            }) }}
        {% else %}
            <span class="recettes-toolbar-label sort-toolbar-label">{{ labelText }}</span>
        {% endif %}

        {% set orderRouteParams = routeParams|merge({'sort': currentSort, 'order': nextOrder}) %}
        <a href="{{ path(route, orderRouteParams) }}"
           class="sort-order-btn"
           title="{{ currentOrder|default('desc') == 'asc' ? 'Tri croissant (cliquer pour trier par ordre décroissant)' : 'Tri décroissant (cliquer pour trier par ordre croissant)' }}"
           aria-label="{{ currentOrder|default('desc') == 'asc' ? 'Tri croissant (cliquer pour trier par ordre décroissant)' : 'Tri décroissant (cliquer pour trier par ordre croissant)' }}">
            {% if currentOrder|default('desc') == 'asc' %}
                <i class="fa-solid fa-arrow-up sort-order-icon" aria-hidden="true"></i>
            {% else %}
                <i class="fa-solid fa-arrow-down sort-order-icon" aria-hidden="true"></i>
            {% endif %}
        </a>
    </div>

    <div class="recettes-sort-pills sort-toolbar-pills">
        {% for item in items %}
            {% set itemActiveKeys = item.activeKeys|default([item.key]) %}
            {% set isActive = currentSort in itemActiveKeys %}
            {% set itemDefaultOrder = item.defaultOrder|default('asc') %}
            {% set targetOrder = isActive ? nextOrder : itemDefaultOrder %}
            {% set pillRouteParams = routeParams|merge({'sort': item.key, 'order': targetOrder}) %}
            <a href="{{ path(route, pillRouteParams) }}"
               class="sort-pill {{ isActive ? 'active' : '' }}"
               data-sort="{{ item.key }}">
                {{ item.label }}
            </a>
        {% endfor %}
    </div>
</div>
