<!-- Modal Popup "Modifier le repas" -->
{% set popupContent %}
    <form method="post" id="edit-meal-form" action="" enctype="multipart/form-data">
        <input type="hidden" name="_token" id="edit-meal-token" value="">
        <input type="hidden" name="moment" id="edit-meal-moment-input" value="soir">

        <div class="modal-proposition-header">
            <h3 class="modal-proposition-title">Modifier le repas</h3>
            <p class="modal-proposition-subtitle">Recette : <strong id="edit-meal-recipe-name" style="color: var(--primary, #c4a587);"></strong></p>
        </div>

        {{ composant('popups/sections/date', {
            'id_prefix': 'edit-meal',
            'input_name': 'realise_at',
            'on_date_change': 'onEditMealDateInputChange(this.value)',
            'on_quick_click': 'selectEditMealDate',
            'on_moment_click': 'selectEditMoment'
        }) }}

        {{ composant('popups/sections/photo', {
            'id_prefix': 'edit-meal',
            'has_delete_input': true,
            'on_trigger_camera': 'triggerEditMealPhotoInput()',
            'on_trigger_gallery': 'triggerEditMealGalleryInput()',
            'on_photo_change': 'onEditMealPhotoSelected(this)',
            'on_delete_existing': 'removeEditMealExistingPhoto()',
            'on_remove_new': 'cancelEditMealNewPhoto()'
        }) }}

        <div class="modal-body edit-meal-body-content">
            <div class="form-group mb-3" style="padding: 0 1.25rem;">
                <label for="edit-meal-complement-input" class="modal-section-label">
                    Complément (texte libre)
                </label>
                <input type="text"
                       name="complement"
                       id="edit-meal-complement-input"
                       class="form-control"
                       placeholder="Ex: riz, frites maison, salade..."
                       maxlength="255"
                       style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; border: 1.5px solid #cbd5e1; font-size: 1rem; box-sizing: border-box;">
            </div>

            {{ composant('popups/sections/personnes', {
                'id_prefix': 'edit-meal',
                'familleMembres': familleMembres|default([])
            }) }}

            {{ composant('popups/sections/note', {
                'id_prefix': 'edit-meal',
                'familleMembres': familleMembres|default([])
            }) }}
        </div>

        <div class="modal-footer">
            <div id="delete-meal-container">
                <button type="button"
                        class="btn-delete-meal"
                        onclick="submitDeleteMeal()">
                    Supprimer ce repas
                </button>
            </div>

            <div style="display: flex; gap: 0.75rem;">
                {{ composant('_composants/button', {
                    'titre': 'Annuler',
                    'type': 'button',
                    'class': 'btn-secondary',
                    'onclick': 'closeEditMealModal()'
                }) }}
                {{ composant('_composants/button', {
                    'titre': 'Enregistrer',
                    'type': 'submit',
                    'class': 'btn-primary'
                }) }}
            </div>
        </div>
    </form>

    <form method="post" id="delete-meal-form" action="" style="display: none;">
        <input type="hidden" name="_token" id="delete-meal-token" value="">
    </form>
{% endset %}

{{ composant('_composants/popup', {
    'id': 'edit-meal-modal',
    'content': popupContent,
    'onClose': 'closeEditMealModal()',
    'onBackdropClick': 'handleEditMealBackdropClick(event)'
}) }}