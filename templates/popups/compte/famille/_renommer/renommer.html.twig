<!-- Modal Popup "Renommer la famille" -->
{% set renameContent %}
    <form method="post" action="{{ path('app_famille_renommer') }}" id="rename-family-form" class="rename-family-form">
        <input type="hidden" name="_token" value="{{ csrf_token('famille_renommer') }}">

        <div class="modal-body rename-family-modal-body">
            <div class="form-group mb-0">
                <label for="family-rename-input" class="form-label" style="display: block; font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.65rem;">
                    Nouveau nom de la famille
                </label>
                <input type="text"
                       id="family-rename-input"
                       name="nom"
                       value="{{ famille ? famille.nom : '' }}"
                       class="form-control family-rename-field"
                       placeholder="Ex: Famille Dupont"
                       required
                       autofocus
                       style="width: 100%; padding: 0.85rem 1rem; border-radius: 12px; border: 1.5px solid #cbd5e1; font-size: 1rem; box-sizing: border-box;">
                <p class="family-rename-hint" style="font-size: 0.85rem; color: #64748b; margin-top: 0.6rem; margin-bottom: 0;">
                    Ce nom sera visible par l'ensemble des membres de votre famille.
                </p>
            </div>
        </div>

        <div class="modal-footer rename-family-modal-footer" style="display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem; padding: 1.25rem 2rem; background: #f8fafc; border-top: 1px solid #f1f5f9; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
            {{ composant('_composants/button', {
                'titre': 'Annuler',
                'type': 'button',
                'class': 'btn-secondary',
                'onclick': "closeModal('rename-family-modal')"
            }) }}
            {{ composant('_composants/button', {
                'titre': 'Enregistrer',
                'type': 'submit',
                'class': 'btn-primary'
            }) }}
        </div>
    </form>
{% endset %}

{{ composant('_composants/popup', {
    'id': 'rename-family-modal',
    'title': 'Renommer la famille',
    'content': renameContent,
    'onClose': "closeModal('rename-family-modal')",
    'onBackdropClick': "handleModalBackdropClick(event, 'rename-family-modal')"
}) }}
