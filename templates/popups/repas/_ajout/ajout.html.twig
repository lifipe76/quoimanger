<!-- Modal Popup "Je rentre mon repas" -->
{% set popupContent %}

    <div class="modal-proposition-header">
        <h3 class="modal-proposition-title">Ajouter votre repas</h3>
        <p class="modal-proposition-subtitle">Choisissez une recette et un moment pour l'ajouter à vos repas.</p>
    </div>

    <!-- Choix de la date et moment sur la même ligne (identique au popup propose) -->
    <div class="modal-date-row">
        <div class="modal-date-left">
            <label for="repas-date-input">Date :</label>
            <input type="date"
                   id="repas-date-input"
                   class="modal-date-input"
                   value="{{ 'now'|date('Y-m-d') }}"
                   onchange="onRepasDateInputChange(this.value)">
            <div class="modal-date-quick-btns">
                <button type="button" class="btn-date-quick active" onclick="selectRepasDate('{{ 'now'|date('Y-m-d') }}', this)">Aujourd'hui</button>
                <button type="button" class="btn-date-quick" onclick="selectRepasDate('{{ '-1 day'|date('Y-m-d') }}', this)">Hier</button>
            </div>
        </div>

        <div class="moment-toggle-group">
            <button type="button"
                    class="btn-moment-toggle {{ defaultMoment|default('soir') == 'matin' ? 'active' : '' }}"
                    data-moment="matin"
                    onclick="selectRepasMoment('matin')">
                Matin
            </button>
            <button type="button"
                    class="btn-moment-toggle {{ defaultMoment|default('soir') == 'midi' ? 'active' : '' }}"
                    data-moment="midi"
                    onclick="selectRepasMoment('midi')">
                Midi
            </button>
            <button type="button"
                    class="btn-moment-toggle {{ defaultMoment|default('soir') == 'soir' ? 'active' : '' }}"
                    data-moment="soir"
                    onclick="selectRepasMoment('soir')">
                Soir
            </button>
        </div>
    </div>

    <!-- Barre de recherche dessous -->
    <div class="modal-top-bar">
        {{ composant('_composants/_popup/recherche', {
            'id': 'recipe-filter-input',
            'placeholder': 'Rechercher une recette...',
            'target': '.modal-recipe-form',
            'oninput': 'filterRecipesList(this.value)'
        }) }}
    </div>

    <div class="modal-recipes-list" id="modal-recipes-container">
        {% if recettes|length > 0 %}
            {% for r in recettes %}
                <form method="post" action="{{ path('app_realisation_add') }}" class="modal-recipe-form" data-name="{{ r.designation|lower }}">
                    <input type="hidden" name="recette_id" value="{{ r.id }}">
                    <input type="hidden" name="moment" class="input-form-moment" value="{{ defaultMoment|default('soir') }}">
                    <input type="hidden" name="date" class="input-form-date" value="{{ 'now'|date('Y-m-d') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('add_realisation') }}">
                    {{ composant('cards/popup/recette', {
                        'recette': r,
                        'ranks': ranks|default({}),
                        'action_label': 'Valider →'
                    }) }}
                </form>
            {% endfor %}
        {% else %}
            <div class="empty-state" style="padding: 2rem 1rem;">
                <div style="margin-top: 0.5rem;">
                    {{ composant('_composants/button', {
                        'titre': '+ Créer une recette d\'abord',
                        'href': path('app_recette_create'),
                        'class': 'btn-primary'
                    }) }}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="modal-footer modal-footer-center">
        {{ composant('_composants/button', {
            'titre': '+ Créer une nouvelle recette',
            'href': path('app_recette_create'),
            'class': 'btn-primary',
            'style': 'width: 100%;'
        }) }}
    </div>
{% endset %}

{{ composant('_composants/popup', {
    'id': 'repas-modal',
    'content': popupContent,
    'onClose': 'closeRepasModal()',
    'onBackdropClick': 'handleModalBackdropClick(event, "repas-modal")'
}) }}