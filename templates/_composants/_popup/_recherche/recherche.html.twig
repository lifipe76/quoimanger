{# Composant barre de recherche pour popups/modales #}
{% set id = id|default('popup-search-input') %}
{% set placeholder = placeholder|default('Rechercher une recette...') %}
{% set oninput = oninput|default('') %}
{% set target = target|default('') %}
{% set expandable = expandable is defined ? expandable : true %}

{% if expandable %}
    <div class="modal-search-expandable" id="{{ id }}-wrapper">
        <button type="button"
                class="btn-search-toggle"
                aria-label="Rechercher"
                title="Rechercher"
                onclick="toggleExpandableSearch('{{ id }}-wrapper', '{{ id }}')">
            <svg class="icon-search" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </button>
        <div class="search-input-collapse">
            <input type="text"
                   id="{{ id }}"
                   class="modal-search-input"
                   placeholder="{{ placeholder }}"
                   autocomplete="off"
                   oninput="{% if oninput %}{{ oninput }};{% endif %}{% if target %}if(typeof filterPopupList==='function'){filterPopupList(this.value, '{{ target }}');}{% endif %} handleSearchInputChange(this, '{{ id }}-wrapper')">
            <button type="button"
                    class="btn-search-clear"
                    aria-label="Effacer la recherche"
                    title="Effacer"
                    onclick="clearExpandableSearch('{{ id }}-wrapper', '{{ id }}'{% if oninput %}, function(){ {{ oninput }} }{% endif %}{% if target %}, '{{ target }}'{% endif %})">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
{% else %}
    <div class="modal-search-field">
        <span class="search-icon" aria-hidden="true">
            <svg class="icon-search" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </span>
        <input type="text"
               id="{{ id }}"
               class="form-control modal-search-input"
               placeholder="{{ placeholder }}"
               autocomplete="off"
               {% if oninput %}oninput="{{ oninput }}"{% endif %}
               {% if target %}data-search-target="{{ target }}" oninput="if(typeof filterPopupList==='function'){filterPopupList(this.value, '{{ target }}');} {{ oninput }}"{% endif %}>
    </div>
{% endif %}
