<!-- Modal Popup "Modifier le repas" -->
{% set popupContent %}
    <form method="post" id="edit-meal-form" action="">
        <input type="hidden" name="_token" id="edit-meal-token" value="">
        <input type="hidden" name="moment" id="edit-meal-moment-input" value="soir">

        <div class="modal-body" style="padding: 1.5rem 1.75rem;">
            <div class="form-group mb-4">
                <label for="edit-meal-date-input" style="display: block; font-weight: 700; margin-bottom: 0.6rem; color: #1e293b; font-size: 0.95rem;">
                    Date du repas
                </label>
                <input type="date"
                       name="realise_at"
                       id="edit-meal-date-input"
                       class="form-control"
                       required
                       style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; border: 1.5px solid #cbd5e1; font-size: 1.05rem; box-sizing: border-box;">
            </div>

            <div class="form-group mb-3">
                <label style="display: block; font-weight: 700; margin-bottom: 0.6rem; color: #1e293b; font-size: 0.95rem;">
                    Moment du repas
                </label>
                <div class="moment-toggle-group">
                    <button type="button" class="btn-edit-moment-toggle" data-moment="matin" onclick="selectEditMoment('matin')">
                        Matin
                    </button>
                    <button type="button" class="btn-edit-moment-toggle" data-moment="midi" onclick="selectEditMoment('midi')">
                        Midi
                    </button>
                    <button type="button" class="btn-edit-moment-toggle" data-moment="soir" onclick="selectEditMoment('soir')">
                        Soir
                    </button>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="edit-meal-complement-input" style="display: block; font-weight: 700; margin-bottom: 0.6rem; color: #1e293b; font-size: 0.95rem;">
                    Complément (texte libre)
                </label>
                <input type="text"
                       name="complement"
                       id="edit-meal-complement-input"
                       class="form-control"
                       placeholder="Ex: riz, frites maison, salade..."
                       maxlength="255"
                       style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; border: 1.5px solid #cbd5e1; font-size: 1rem; box-sizing: border-box;">
            </div>

            {% if familleMembres is defined and familleMembres|length > 0 %}
                <div class="form-group mb-2" id="edit-meal-participants-section">
                    <input type="hidden" name="has_participants_field" value="1">
                    <label style="display: block; font-weight: 700; margin-bottom: 0.6rem; color: #1e293b; font-size: 0.95rem;">
                        Qui a pris ce repas ?
                    </label>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" id="edit-meal-participants-container">
                        {% for membre in familleMembres %}
                            <label class="participant-toggle-label" style="display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.45rem 0.85rem; background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 9999px; cursor: pointer; font-size: 0.875rem; font-weight: 600; color: #334155; user-select: none; transition: all 0.2s;">
                                <input type="checkbox" name="participants[]" value="{{ membre.id }}" class="participant-checkbox" style="accent-color: var(--primary); width: 16px; height: 16px;">
                                <span>{{ membre.displayName }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem; margin-bottom: 0;">
                        Laissez vide pour indiquer que toute la famille a pris le repas.
                    </p>
                </div>
            {% endif %}

            <div class="form-group mb-2" id="edit-meal-ratings-section" style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px dashed #e2e8f0;">
                <label style="display: block; font-weight: 700; margin-bottom: 0.6rem; color: #1e293b; font-size: 0.95rem;">
                    ⭐ Noter ce repas
                </label>
                {% if familleMembres is defined and familleMembres|length > 0 %}
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;" id="edit-meal-ratings-container">
                        {% for membre in familleMembres %}
                            <div class="member-rating-row" style="display: flex; align-items: center; justify-content: space-between; padding: 0.45rem 0.85rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px;">
                                <div style="display: flex; align-items: center; gap: 0.4rem;">
                                    <span style="font-size: 0.875rem; font-weight: 600; color: #334155;">{{ membre.displayName }}</span>
                                    {% if app.user and membre.id == app.user.id %}
                                        <span style="font-size: 0.75rem; color: var(--primary); font-weight: 600;">(Vous)</span>
                                    {% endif %}
                                </div>
                                <div class="modal-star-rating" data-user-id="{{ membre.id }}">
                                    {% if app.user and membre.id == app.user.id %}
                                        <input type="hidden" name="notes[{{ membre.id }}]" id="edit-meal-note-{{ membre.id }}" value="0">
                                        {% for star in 1..5 %}
                                            <button type="button" class="modal-star-btn" data-star="{{ star }}" onclick="setModalMemberStar({{ membre.id }}, {{ star }})" style="background: none; border: none; font-size: 1.25rem; color: #cbd5e1; cursor: pointer; padding: 0 2px; line-height: 1;" title="Attribuer {{ star }} étoile(s)">★</button>
                                        {% endfor %}
                                    {% else %}
                                        {% for star in 1..5 %}
                                            <span class="modal-star-display" data-star="{{ star }}" style="font-size: 1.25rem; color: #cbd5e1; padding: 0 2px; line-height: 1; user-select: none; display: inline-block;">★</span>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% elseif app.user %}
                    <div class="member-rating-row" style="display: flex; align-items: center; justify-content: space-between; padding: 0.45rem 0.85rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px;">
                        <span style="font-size: 0.875rem; font-weight: 600; color: #334155;">Votre note</span>
                        <div class="modal-star-rating" data-user-id="{{ app.user.id }}">
                            <input type="hidden" name="notes[{{ app.user.id }}]" id="edit-meal-note-{{ app.user.id }}" value="0">
                            {% for star in 1..5 %}
                                <button type="button" class="modal-star-btn" data-star="{{ star }}" onclick="setModalMemberStar({{ app.user.id }}, {{ star }})" style="background: none; border: none; font-size: 1.35rem; color: #cbd5e1; cursor: pointer; padding: 0 3px; line-height: 1;" title="Attribuer {{ star }} étoile(s)">★</button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 1.25rem 1.75rem; background: #f8fafc; border-top: 1px solid #f1f5f9; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
            <div id="delete-meal-container">
                <button type="button"
                        class="btn-delete-meal"
                        onclick="submitDeleteMeal()"
                        style="background: transparent; color: #dc2626; border: 1px solid #fecaca; border-radius: 10px; padding: 0.6rem 1rem; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    Supprimer ce repas
                </button>
            </div>

            <div style="display: flex; gap: 0.75rem;">
                {{ composant('_composants/button', {
                    'titre': 'Annuler',
                    'type': 'button',
                    'class': 'btn-secondary',
                    'onclick': 'closeEditMealModal()'
                }) }}
                {{ composant('_composants/button', {
                    'titre': 'Enregistrer',
                    'type': 'submit',
                    'class': 'btn-primary'
                }) }}
            </div>
        </div>
    </form>

    <form method="post" id="delete-meal-form" action="" style="display: none;">
        <input type="hidden" name="_token" id="delete-meal-token" value="">
    </form>
{% endset %}

{{ composant('_composants/popup', {
    'id': 'edit-meal-modal',
    'title': 'Modifier le repas : <strong id="edit-meal-recipe-name" style="color: var(--primary, #c4a587);"></strong>',
    'content': popupContent,
    'onClose': 'closeEditMealModal()',
    'onBackdropClick': 'handleEditMealBackdropClick(event)'
}) }}