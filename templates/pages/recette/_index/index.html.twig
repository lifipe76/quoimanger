{% extends 'base.html.twig' %}

{% block title %}Recettes - QuoiManger{% endblock %}

{% block body %}
{% set indexContent %}
    <div class="page-header recettes-header">
        <div class="recettes-header-title-wrap">
            <h1 class="page-title">Mes Recettes</h1>
            <p class="page-subtitle">{{ recettes|length }} recette{{ recettes|length > 1 ? 's' : '' }} au menu</p>
        </div>
        {{ composant('_composants/button', {
            'titre': '+ Ajouter une recette',
            'href': path('app_recette_create'),
            'class': 'btn-primary'
        }) }}
    </div>

    {{ composant('_composants/sortToolbar', {
        'currentSort': currentSort|default('date'),
        'currentOrder': currentOrder|default('desc'),
        'route': 'app_recettes_list',
        'storageKey': 'quoiManger_recettes',
        'defaultSort': 'date',
        'defaultOrder': 'desc',
        'searchTarget': '.card-recette',
        'searchId': 'recettes-search-input',
        'searchPlaceholder': 'Rechercher une recette...',
        'items': [
            {'key': 'date', 'label': 'Date', 'defaultOrder': 'desc', 'activeKeys': ['date', 'recent', 'oldest']},
            {'key': 'note', 'label': 'Note', 'defaultOrder': 'desc'},
            {'key': 'rank', 'label': 'Rang', 'defaultOrder': 'asc'},
            {'key': 'alpha', 'label': 'Nom', 'defaultOrder': 'asc'},
            {'key': 'frigo', 'label': 'Mon frigo', 'defaultOrder': 'desc', 'activeKeys': isFrigo|default(false) ? ['frigo', currentSort] : ['frigo']}
        ]
    }) }}

    {% if recettes|length > 0 %}
        <div class="cards-grid">
            {% for recette in recettes %}
                {{ composant('cards/recette', { 'recette': recette, 'index': loop.index0, 'ranks': ranks|default({}) }) }}
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state card">
            <div class="empty-state-icon">🍳</div>
            <h2>Aucune recette pour le moment</h2>
            <p>Commencez par ajouter votre première recette avec ses ingrédients favoris.</p>
            <div style="margin-top: 1.5rem;">
                {{ composant('_composants/button', {
                    'titre': '+ Créer ma première recette',
                    'href': path('app_recette_create'),
                    'class': 'btn-primary'
                }) }}
            </div>
        </div>
    {% endif %}
{% endset %}

{{ composant('_composants/container', {
    'content': indexContent
}) }}
{% endblock %}
