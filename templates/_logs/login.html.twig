{% extends 'base.html.twig' %}

{% block title %}Connexion - QuoiManger{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ addCss('styles/recettes.css') }}
{% endblock %}

{% block body %}
<div class="container" style="max-width: 480px; margin: 3rem auto 5rem; padding: 0 1.5rem;">
    {% if app.user %}
        <div class="card" style="text-align: center; padding: 2.5rem 2rem;">
            <div style="font-size: 3rem; margin-bottom: 0.75rem;">👋</div>
            <h1 class="page-title" style="font-size: 1.6rem; margin-bottom: 0.5rem;">Vous êtes déjà connecté</h1>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">
                Connecté avec le compte <strong>{{ app.user.userIdentifier }}</strong>
            </p>

            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                <a href="{{ path('home') }}" class="btn btn-primary" style="width: 100%;">
                    Accéder à la Timeline des Repas
                </a>
                <a href="{{ path('app_recettes_list') }}" class="btn btn-secondary" style="width: 100%;">
                    Voir toutes les recettes
                </a>
                <a href="{{ path('web_logout') }}" class="btn btn-danger" style="width: 100%; margin-top: 0.5rem;">
                    Se déconnecter
                </a>
            </div>
        </div>
    {% else %}
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; background: #fff4ed; border-radius: 20px; font-size: 2rem; margin-bottom: 1rem; box-shadow: 0 4px 12px var(--primary-glow);">
                🔐
            </div>
            <h1 class="page-title" style="font-size: 1.85rem; margin-bottom: 0.5rem;">Connexion</h1>
            <p class="page-subtitle">
                Accédez à vos recettes et suivez vos repas au quotidien
            </p>
        </div>

        {% if error %}
            <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' or label == 'error' ? 'danger' : 'success' }}" style="margin-bottom: 1.5rem;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card">
            <form method="post" action="{{ path('web_login') }}">
                <div class="form-group">
                    <label for="username" class="form-label">Adresse email</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="_username"
                           id="username"
                           class="form-control"
                           placeholder="nom@exemple.com"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label for="password" class="form-label">Mot de passe</label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input type="password"
                               name="_password"
                               id="password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               required
                               style="padding-right: 46px;">
                        <button type="button"
                                id="toggle-password-btn"
                                onclick="togglePasswordVisibility('password', this)"
                                title="Afficher/Masquer le mot de passe"
                                style="position: absolute; right: 12px; background: none; border: none; cursor: pointer; padding: 4px; color: var(--text-muted); display: flex; align-items: center; justify-content: center;">
                            <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.5rem;">
                    <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--text-muted); cursor: pointer;">
                        <input type="checkbox" name="_remember_me" checked style="accent-color: var(--primary); width: 16px; height: 16px;">
                        Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" style="color: var(--primary); font-size: 0.875rem; font-weight: 600; text-decoration: none;">
                        Mot de passe oublié ?
                    </a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 1rem;">
                    Se connecter
                </button>
            </form>
        </div>

        <div style="text-align: center; margin-top: 1.75rem;">
            <a href="{{ path('home') }}" style="color: var(--text-muted); font-size: 0.875rem; text-decoration: none;">
                ← Retour au tableau de bord
            </a>
        </div>
    {% endif %}
</div>

<script>
function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';

    btn.innerHTML = isPassword
        ? `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
            <line x1="2" x2="22" y1="2" y2="22"/>
           </svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
           </svg>`;
}
</script>
{% endblock %}