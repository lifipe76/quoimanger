{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Nouvelle action' : 'Modifier l\'action' }} - QuoiFaire{% endblock %}

{% block body %}
{% if not isNew %}
    {{ composant('popups/confirmation') }}
    <form id="delete-action-form"
          method="post"
          action="{{ path('app_action_delete', {'id': action.id}) }}"
          data-confirm="Êtes-vous sûr de vouloir supprimer définitivement l'action « {{ action.designation }} » ?"
          data-confirm-title="Supprimer l'action"
          data-confirm-btn="Supprimer"
          style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_action_' ~ action.id) }}">
    </form>
{% endif %}

{% set formContent %}
    <div class="page-header">
        <h1 class="page-title">{{ isNew ? 'Ajouter une action' : 'Modifier l\'action' }}</h1>
        {{ composant('_composants/button', {
            'titre': 'Retour à la liste',
            'href': destination == 'quoifaire' ? path('quoifaire_home') : path('app_actions_list'),
            'class': 'btn-secondary'
        }) }}
    </div>

    <div class="card">
        {{ form_start(form, {
            'action': isNew ? path('app_action_create', destination ? {'destination': destination} : {}) : path('app_action_edit', destination ? {'id': action.id, 'destination': destination} : {'id': action.id}),
            'multipart': true,
            'attr': {'id': 'action-form', 'enctype': 'multipart/form-data'}
        }) }}
            <input type="hidden" name="destination" value="{{ destination }}">
            <div class="form-group">
                {{ form_label(form.designation, null, {'label_attr': {'class': 'form-label'} }) }}
                {{ form_widget(form.designation) }}
                {{ form_errors(form.designation, {'attr': {'class': 'form-error'} }) }}
            </div>

            {{ composant('_composants/photoInput', {
                'prefix': 'action',
                'label': "Photos de l'action",
                'current_photos': action.photos,
                'current_photo_urls': action.photoUrls,
                'alt_text': 'Photo de ' ~ action.designation,
                'camera_title': "Prendre une photo de l'action",
                'gallery_title': 'Choisir des fichiers'
            }) }}

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
                <div>
                    {% if not isNew %}
                        <button type="submit"
                                form="delete-action-form"
                                class="btn btn-danger btn-sm btn-delete-small"
                                title="Supprimer définitivement cette action"
                                aria-label="Supprimer cette action">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                </div>
                <div style="display: flex; gap: 1rem; margin-left: auto;">
                    {{ composant('_composants/button', {
                        'titre': 'Annuler',
                        'href': destination == 'quoifaire' ? path('quoifaire_home') : path('app_actions_list'),
                        'class': 'btn-secondary'
                    }) }}
                    {{ composant('_composants/button', {
                        'titre': isNew ? 'Créer l\'action' : 'Enregistrer les modifications',
                        'type': 'submit',
                        'class': 'btn-primary'
                    }) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>
{% endset %}

{{ composant('_composants/container', {
    'content': formContent
}) }}
{% endblock %}
