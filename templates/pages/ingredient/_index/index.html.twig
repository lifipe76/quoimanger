{% extends 'base.html.twig' %}

{% block title %}Ingrédients - QuoiManger{% endblock %}

{% block body %}
{% set indexContent %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Mes Ingrédients</h1>
            <p class="page-subtitle">{{ ingredients|length }} ingrédient{{ ingredients|length > 1 ? 's' : '' }} répertorié{{ ingredients|length > 1 ? 's' : '' }}</p>
        </div>
        {{ composant('_composants/button', {
            'titre': '+ Ajouter un ingrédient',
            'href': path('app_ingredient_create'),
            'class': 'btn-primary'
        }) }}
    </div>

    {% if ingredients|length > 0 %}
        <div class="cards-grid">
            {% for ingredient in ingredients %}
                {{ composant('cards/ingredient', { 'ingredient': ingredient, 'index': loop.index0 }) }}
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state card">
            <div class="empty-state-icon">🌿</div>
            <h2>Aucun ingrédient pour le moment</h2>
            <p>Ajoutez des ingrédients pour pouvoir composer vos futures recettes.</p>
            <div style="margin-top: 1.5rem;">
                {{ composant('_composants/button', {
                    'titre': '+ Créer mon premier ingrédient',
                    'href': path('app_ingredient_create'),
                    'class': 'btn-primary'
                }) }}
            </div>
        </div>
    {% endif %}
{% endset %}

{{ composant('_composants/container', {
    'content': indexContent
}) }}
{% endblock %}
