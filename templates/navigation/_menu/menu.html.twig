{% set current_route = app.current_route|default(app.request.attributes.get('_route')) %}
{% set is_auth_page = (current_route in ['web_login', 'app_register', 'app_register_alias']) %}
{% set is_account_page = (current_route starts with 'app_account' or current_route starts with 'app_famille') %}
{% set is_recettes_page = (current_route starts with 'app_recette') %}
{% set is_ingredients_page = (current_route starts with 'app_ingredient') %}
{% set is_boissons_page = (current_route starts with 'app_boisson') %}
{% set is_home_page = (current_route == 'home') %}
{% set is_messagerie_page = (current_route starts with 'app_messagerie') %}
{% set is_action_page = (current_route starts with 'app_action') %}
{% set is_quoifaire_home = (current_route == 'quoifaire_home') %}
{% set session_mode = app.request.hasSession() ? app.session.get('app_mode') : null %}
{% set is_quoifaire = is_action_page or is_quoifaire_home or (session_mode == 'quoifaire' and not (is_recettes_page or is_ingredients_page or is_boissons_page or is_home_page)) %}

{# Configuration de la navigation séquentielle #}
{% set nav_left_url = null %}
{% set nav_left_title = null %}
{% set nav_right_url = null %}
{% set nav_right_title = null %}

{% if not is_auth_page %}
    {% if is_quoifaire %}
        {% if is_action_page %}
            {# Actions : gauche -> rien, droite -> Fil actions #}
            {% set nav_right_url = path('quoifaire_home') %}
            {% set nav_right_title = 'Vers Fil actions' %}
        {% elseif is_quoifaire_home %}
            {# Fil actions : gauche -> Actions, droite -> Messagerie #}
            {% set nav_left_url = path('app_actions_list') %}
            {% set nav_left_title = 'Vers Actions' %}
            {% if app.user %}
                {% set nav_right_url = path('app_messagerie') %}
                {% set nav_right_title = 'Vers Messagerie' %}
            {% endif %}
        {% elseif is_messagerie_page %}
            {# Messagerie : gauche -> Fil actions, droite -> Mon compte #}
            {% set nav_left_url = path('quoifaire_home') %}
            {% set nav_left_title = 'Vers Fil actions' %}
            {% if app.user %}
                {% set nav_right_url = path('app_account_profile') %}
                {% set nav_right_title = 'Vers Mon compte' %}
            {% endif %}
        {% elseif is_account_page %}
            {# Mon compte : gauche -> Messagerie (ou Fil actions) #}
            {% set nav_left_url = app.user ? path('app_messagerie') : path('quoifaire_home') %}
            {% set nav_left_title = app.user ? 'Vers Messagerie' : 'Vers Fil actions' %}
        {% endif %}
    {% else %}
        {% if is_recettes_page %}
            {# Recettes : gauche -> rien, droite -> Ingrédients #}
            {% set nav_right_url = path('app_ingredients_list') %}
            {% set nav_right_title = 'Vers Ingrédients' %}
        {% elseif is_ingredients_page %}
            {# Ingrédients : gauche -> Recettes, droite -> Boissons #}
            {% set nav_left_url = path('app_recettes_list') %}
            {% set nav_left_title = 'Vers Recettes' %}
            {% set nav_right_url = path('app_boissons_list') %}
            {% set nav_right_title = 'Vers Boissons' %}
        {% elseif is_boissons_page %}
            {# Boissons : gauche -> Ingrédients, droite -> Fil #}
            {% set nav_left_url = path('app_ingredients_list') %}
            {% set nav_left_title = 'Vers Ingrédients' %}
            {% set nav_right_url = path('home') %}
            {% set nav_right_title = 'Vers Fil repas' %}
        {% elseif is_home_page %}
            {# Fil : gauche -> Boissons, droite -> Messagerie (ou Compte si pas de messagerie) #}
            {% set nav_left_url = path('app_boissons_list') %}
            {% set nav_left_title = 'Vers Boissons' %}
            {% if app.user %}
                {% set nav_right_url = path('app_messagerie') %}
                {% set nav_right_title = 'Vers Messagerie' %}
            {% endif %}
        {% elseif is_messagerie_page %}
            {# Messagerie : gauche -> Fil, droite -> Mon compte #}
            {% set nav_left_url = path('home') %}
            {% set nav_left_title = 'Vers Fil repas' %}
            {% if app.user %}
                {% set nav_right_url = path('app_account_profile') %}
                {% set nav_right_title = 'Vers Mon compte' %}
            {% endif %}
        {% elseif is_account_page %}
            {# Mon compte : gauche -> Messagerie (ou Fil si pas connecté) #}
            {% set nav_left_url = app.user ? path('app_messagerie') : path('home') %}
            {% set nav_left_title = app.user ? 'Vers Messagerie' : 'Vers Fil repas' %}
        {% endif %}
    {% endif %}
{% endif %}

<header class="nav-header{{ is_account_page ? ' is-account-page' : '' }}{{ is_auth_page ? ' is-auth-page' : '' }}">
    <!-- Pilule Gauche : Logo, Titre & Navigation principale -->
    <div class="nav-pill nav-pill-left">
        {% if nav_left_url %}
            <a href="{{ nav_left_url }}" class="nav-back-btn" title="{{ nav_left_title }}" aria-label="{{ nav_left_title }}">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        {% endif %}

        <div class="nav-brand-switcher" id="brandSwitcher">
            <a href="{{ is_quoifaire ? path('quoifaire_home') : path('home') }}" class="nav-brand" title="{{ is_quoifaire ? 'QuoiFaire (Fil actions)' : 'QuoiManger (Fil repas)' }}">
                <span class="nav-brand-logo" aria-hidden="true">{{ is_quoifaire ? '🏠' : '🍽️' }}</span>
            </a>

            <div class="nav-brand-popup nav-brand-popup-down" id="brandPopup">
                <!-- 1. Icône superposée à celle affichée -->
                <a href="{{ is_quoifaire ? path('quoifaire_home') : path('home') }}"
                   class="nav-brand-popup-item active"
                   title="{{ is_quoifaire ? 'QuoiFaire (Fil actions)' : 'QuoiManger (Fil repas)' }}">
                    <span class="nav-brand-popup-logo" aria-hidden="true">{{ is_quoifaire ? '🏠' : '🍽️' }}</span>
                </a>
                <!-- 2. Icône dessous -->
                <a href="{{ is_quoifaire ? path('home') : path('quoifaire_home') }}"
                   class="nav-brand-popup-item"
                   title="{{ is_quoifaire ? 'QuoiManger (Fil repas)' : 'QuoiFaire (Fil actions)' }}">
                    <span class="nav-brand-popup-logo" aria-hidden="true">{{ is_quoifaire ? '🍽️' : '🏠' }}</span>
                </a>
            </div>
        </div>

        {% if nav_right_url %}
            <a href="{{ nav_right_url }}" class="nav-next-btn" title="{{ nav_right_title }}" aria-label="{{ nav_right_title }}">
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        {% endif %}

        {% if not is_auth_page %}
            <nav class="nav-links nav-links-main">
                {% if is_quoifaire %}
                    <a href="{{ path('app_actions_list') }}" class="nav-link{{ current_route starts with 'app_action' ? ' active' : '' }}">Actions</a>
                {% else %}
                    <a href="{{ path('app_recettes_list') }}" class="nav-link{{ current_route starts with 'app_recette' ? ' active' : '' }}">Recettes</a>
                    <a href="{{ path('app_ingredients_list') }}" class="nav-link{{ current_route starts with 'app_ingredient' ? ' active' : '' }}">Ingrédients</a>
                    <a href="{{ path('app_boissons_list') }}" class="nav-link{{ current_route starts with 'app_boisson' ? ' active' : '' }}">Boissons</a>
                {% endif %}
            </nav>
        {% endif %}
    </div>

    <!-- Pilule Droite : Actions utilisateur (Messagerie & Compte / Connexion) -->
    {% if not is_auth_page %}
        <div class="nav-pill nav-pill-right">
            <nav class="nav-links nav-links-user">
                {% if app.user %}
                    {% set has_pending_invitation = (pending_family_invitations()|length > 0) %}
                    <a href="{{ path('app_messagerie') }}" class="nav-link nav-messagerie-link{{ current_route starts with 'app_messagerie' ? ' active' : '' }}" title="Messagerie">
                        <i class="fa-solid fa-comments"></i>
                        <span>Messagerie</span>
                    </a>

                    {# Bouton se déconnecter affiché dans la gélule de droite uniquement sur Mon compte en mode téléphone #}
                    <a href="{{ url('web_logout') }}" class="nav-link nav-logout-mobile" title="Se déconnecter" aria-label="Se déconnecter">
                        <i class="fa-solid fa-sign-out-alt"></i>
                        <span>Déconnexion</span>
                    </a>

                    <div class="user-menu-container" id="userMenuContainer">
                        <a id="avatarMenuImg" href="{{ path('app_account_profile') }}" class="nav-link nav-account-link{{ (is_account_page) ? ' active' : '' }}" title="Mon compte" aria-label="Mon compte">
                            <i class="fa-solid fa-user fa-fw"></i>
                            <span>Compte</span>
                            {% if has_pending_invitation %}
                                <span class="nav-alert-badge" title="Invitation en attente">!</span>
                            {% endif %}
                        </a>

                        <div class="popup-menu popup-menu-user" id="userPopupMenu">
                            <div class="popup-user-header">
                                <div class="popup-user-name">{{ app.user ? ((app.user.firstname ~ ' ' ~ app.user.lastname)|trim ?: app.user.userIdentifier) : '' }}</div>
                                <div class="popup-user-role">{{ app.user ? app.user.email : '' }}</div>
                            </div>
                            <div class="popup-user-body">
                                <a href="{{ path('app_account_profile') }}" class="popup-user-item">
                                    <i class="fa-solid fa-user-gear fa-fw"></i>
                                    <span>Mon compte</span>
                                </a>
                                <a href="{{ path('app_account_profile', {'tab': 'famille'}) }}" class="popup-user-item">
                                    <i class="fa-solid fa-users fa-fw"></i>
                                    <span>Ma famille</span>
                                    {% if has_pending_invitation %}
                                        <span class="tab-alert-badge" title="Invitation en attente">!</span>
                                    {% endif %}
                                </a>
                                <a href="{{ url('web_logout') }}" class="popup-user-item popup-item-logout">
                                    <i class="fa-solid fa-sign-out-alt fa-fw"></i>
                                    <span>Se déconnecter</span>
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('web_login') }}" class="nav-link nav-login-link{{ current_route == 'web_login' ? ' active' : '' }}">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>Connexion</span>
                    </a>
                {% endif %}
            </nav>
        </div>
    {% endif %}
</header>
